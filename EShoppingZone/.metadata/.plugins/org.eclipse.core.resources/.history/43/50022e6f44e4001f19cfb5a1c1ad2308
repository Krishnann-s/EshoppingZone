package com.eshopingzone.productservice.Dto;

import java.io.IOException;
import java.io.InputStream;
import java.math.BigDecimal;
import java.util.ArrayList;
import java.util.List;
import java.util.stream.Collectors;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Component;

import com.eshopingzone.productservice.modal.Products;
import com.eshopingzone.productservice.modal.Rating;
import com.eshopingzone.productservice.repository.ProductsRepository;
import com.fasterxml.jackson.core.type.TypeReference;
import com.fasterxml.jackson.databind.ObjectMapper;

@Component
public class JsonDataLoaderImpl {

	@Autowired
	private ProductsRepository prodRepo;
	
	@Autowired
	private ObjectMapper objectMapper;
	
	public void run(String... args) throws Exception {
        if (prodRepo.count() == 0) {
            // Load data only if database is empty
            loadProductData();
        }
    }

	private void loadProductData() {
		try {
            // Read JSON file from resources
            InputStream inputStream = TypeReference.class.getResourceAsStream("/products.json");
            List<ProductsDto> productDTOs = objectMapper.readValue(inputStream, new TypeReference<List<ProductsDto>>() {});
            
            // Convert DTOs to entities and save
            List<Products> products = productDTOs.stream()
                    .map(dto -> convertToEntity(dto))
                    .collect(Collectors.toList());
            prodRepo.saveAll(products);
            
            System.out.println("Product data loaded successfully!");
        } catch (IOException e) {
            System.err.println("Failed to load product data: " + e.getMessage());
            throw new RuntimeException("Failed to load product data", e);
        }
		
	}
	
	private Products convertToEntity(ProductDTO dto) {
        Products product = new Products();
        product.setProductId(dto.getId());
        product.setTitle(dto.getTitle());
        product.setPrice(new BigDecimal(dto.getPrice()));
        product.setDescription(dto.getDescription());
        product.setCategory(dto.getCategory());
        product.setImage(dto.getImage());

        // Convert rating
        Rating rating = new Rating();
        rating.setRate(dto.getRating().getRate());
        rating.setCount(dto.getRating().getCount());
        rating.setProducts(product);

        List<Rating> ratings = new ArrayList<>();
        ratings.add(rating);
        product.setRating(ratings);

        return product;
    }

    // DTO classes to match JSON structure
    private static class ProductDTO {
        private int id;
        private String title;
        private double price;
        private String description;
        private String category;
        private String image;
        private RatingDTO rating;

        // Getters and setters
        public int getId() { return id; }
        public void setId(int id) { this.id = id; }
        public String getTitle() { return title; }
        public void setTitle(String title) { this.title = title; }
        public double getPrice() { return price; }
        public void setPrice(double price) { this.price = price; }
        public String getDescription() { return description; }
        public void setDescription(String description) { this.description = description; }
        public String getCategory() { return category; }
        public void setCategory(String category) { this.category = category; }
        public String getImage() { return image; }
        public void setImage(String image) { this.image = image; }
        public RatingDTO getRating() { return rating; }
        public void setRating(RatingDTO rating) { this.rating = rating; }
    }

    private static class RatingDTO {
        private double rate;
        private int count;

        // Getters and setters
        public double getRate() { return rate; }
        public void setRate(double rate) { this.rate = rate; }
        public int getCount() { return count; }
        public void setCount(int count) { this.count = count; }
    }
}
