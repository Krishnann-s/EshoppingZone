package com.eshopingzone.productservice.Dao;

import java.util.List;

import com.eshopingzone.productservice.controller.ProductsController;
import com.eshopingzone.productservice.modal.Products;
import com.fasterxml.jackson.databind.ObjectMapper;

public class ProductsDao {

    public List<Products> getAllProducts() {
        ObjectMapper mapper = new ObjectMapper();
        List<Products> products = null;
        try {
            products = mapper.readValue(
                    getClass().getClassLoader().getResourceAsStream("products.json"),
                    mapper.getTypeFactory().constructCollectionType(List.class, Products.class)
            );
            for (Products p : products) {
                p.setImage(linkTo(methodOn(ProductsController.class).getImage(p.getImage())).withRel("image").getHref());
            }
        } catch (Exception e) {
            e.printStackTrace();
        }
        return products;
    }

}
