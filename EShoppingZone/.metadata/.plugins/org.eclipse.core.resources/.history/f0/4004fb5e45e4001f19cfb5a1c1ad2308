package com.eshopingzone.productservice.service;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;

import com.eshopingzone.productservice.exception.ProductNotFoundException;
import com.eshopingzone.productservice.exception.ProductsAlreadyExistsException;
import com.eshopingzone.productservice.modal.Products;
import com.eshopingzone.productservice.modal.Rating;
import com.eshopingzone.productservice.repository.ProductsRepository;
import com.eshopingzone.productservice.repository.RatingRepository;

public class ProductsServiceImpl implements ProductsService{
	
	@Autowired
	private ProductsRepository prodRepo;
	
	@Autowired
	private RatingRepository ratingRepo;

	@Override
	public Products addProducts(Products products, int id) {
		if(prodRepo.existsById(id)) {
			throw new ProductsAlreadyExistsException("Product with ProductId: " + id + " already exists"); 
		}
		products.setProductId(id);
		
		if (products.getRating() != null && !products.getRating().isEmpty()) {
            for (Rating rating : products.getRating()) {
                rating.setProducts(products); // Set the bidirectional relationship
            }
        }
		
		return prodRepo.save(products);
	}

	@Override
	public List<Products> viewProducts() {
		List<Products> products = prodRepo.findAll();
		products.forEach(null);
	}

	@Override
	public Products viewProductsById(int id) {
		Products prod = prodRepo.findById(id).orElseThrow(() -> new ProductNotFoundException("Product with product id: " + id + " not found."));
		return prod;
	}

	@Override
	public List<Products> updateProducts(Products products, int id) {
		Products prodId = prodRepo.findById(id).orElseThrow(() -> new ProductNotFoundException("Product with product_id: " + id + " not found."));
		if(prodRepo.existsById(id)) {
			throw new ProductsAlreadyExistsException("Product with ProductId: " + id + " already exists"); 
		}
		prodRepo.save(products);
		return prodRepo.findAll();
	}

	@Override
	public void deleteProducts(int id) {
		
		prodRepo.deleteById(id);
	}

}
